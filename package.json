{
  "name": "@traces-sh/mcp",
  "version": "0.1.0",
  "description": "Official MCP server for searching and reading Traces sessions.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "traces-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/stdio.ts src/http.ts --outdir dist --target node --format esm --external @modelcontextprotocol/sdk --external zod",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "dev:http": "bun --watch src/http.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepack": "bun run check",
    "start": "bun src/stdio.ts",
    "start:http": "bun src/http.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traces-sh/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/traces-sh/mcp/issues"
  },
  "homepage": "https://github.com/traces-sh/mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "traces",
    "coding-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.8",
    "typescript": "^5.9.3"
  }
}
